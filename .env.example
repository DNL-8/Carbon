# =============================================================================
# Fitness RPG & Saúde — Variáveis de Ambiente (.env)
# =============================================================================
# Copie este arquivo para .env e preencha os valores localmente.
# Nunca commite o arquivo .env nem coloque segredos reais neste arquivo.
# =============================================================================

# -----------------------------------------------------------------------------
# URL do Frontend e Origens Permitidas (Next.js legado)
# Em preview online ou múltiplos domínios, liste as origens separadas por vírgula em ALLOWED_ORIGINS.
# -----------------------------------------------------------------------------
APP_URL=http://localhost:3000
ALLOWED_ORIGINS=

# -----------------------------------------------------------------------------
# Firebase (Next.js legado, não utilizado pelo Nuxt)
# A configuração pública do projeto fica em ./firebase-applet-config.json
# Ative Google e E-mail/Senha em Firebase Console > Authentication > Sign-in method
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# IA (Google Gemini)
# Opcional — usado pelo Oráculo e insights de relatórios no backend.
# -----------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=
AI_ALLOWED_UID=
AI_RATE_LIMIT_REDIS_URL=
AI_RATE_LIMIT_REDIS_TOKEN=

# -----------------------------------------------------------------------------
# Strava (OAuth 2.0 + Importação de atividades)
# Nuxt: requer STRAVA_SESSION_SECRET (>= 32 chars). SESSION_SECRET é legado.
# -----------------------------------------------------------------------------
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_SESSION_SECRET=
SESSION_SECRET=

# -----------------------------------------------------------------------------
# Outros
# -----------------------------------------------------------------------------
PORT=3000
APP_TIME_ZONE=America/Sao_Paulo
# App Nuxt ativo. Use a conexão direta nas migrações e a conexão pooled na aplicação.
DATABASE_URL=
DATABASE_URL_DIRECT=
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
AUTH_EMAIL_FROM=
