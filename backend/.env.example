# Use the database and restricted database role for the target environment.
DATABASE_URL=
# Fixed trusted origin of the existing Nitro Better Auth service (not the FastAPI origin).
AUTH_ORIGIN=http://localhost:3000

# Public application origin for provider callbacks (not the FastAPI URL).
BETTER_AUTH_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_SESSION_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=

# Enable only in an isolated development/test environment until cutover is approved.
ENABLE_WRITES=false
