import { expect, test } from '@playwright/test'
import AxeBuilder from '@axe-core/playwright'
import { EQUIPMENT_CATALOG } from '../../../src/utils/equipmentCatalog'

test('GLB: ambos os personagens, 104 peças, conjuntos e controles',async({page},info)=>{
  const errors:string[]=[]
  page.on('pageerror',error=>errors.push(error.message))
  await page.goto('/avatar-v2-lab-test')
  const canvas=page.locator('canvas[data-glb-character]')
  await expect(canvas).toHaveAttribute('data-glb-character','murim',{timeout:30000})
  await page.getByRole('button',{name:'Pausar',exact:true}).click()
  const piece=page.getByLabel('Peça')
  const character=page.getByLabel('Personagem')
  expect(EQUIPMENT_CATALOG).toHaveLength(104)
  // Fail immediately if an appearance control is not correctly named.
  for(const name of ['Cabelo','Rosto','Pele','Cor do cabelo','Energia']){
    await expect(page.getByRole('combobox',{name,exact:true})).toHaveCount(1)
  }
  for(const style of ['murim','cacador']){
    await character.selectOption(style)
    await expect(canvas).toHaveAttribute('data-glb-character',style)
    await expect(canvas).toHaveAttribute('data-glb-skins',['skinned','blender'].includes(process.env.AVATAR_LAB_RIG??'rigid')?'5':'0')
    for(const item of EQUIPMENT_CATALOG){
      await piece.selectOption(item.id)
      await expect(canvas).toHaveAttribute('data-glb-equipment',item.id)
    }
    const sets=new Map(EQUIPMENT_CATALOG.filter(item=>item.setId).map(item=>[item.setId,item.id]))
    expect(sets.size).toBe(10)
    await page.getByLabel('Conjunto completo').check()
    for(const [set,id] of sets){
      await piece.selectOption(id)
      const selected=EQUIPMENT_CATALOG.find(item=>item.id===id)
      if(!selected)throw Error('Peça de conjunto ausente: '+id)
      const members=EQUIPMENT_CATALOG.filter(item=>item.setId===set)
      const expected=(['elmo','armadura','capa','arma'] as const).map(slot=>selected.slot===slot?selected:members.find(item=>item.slot===slot))
      expect(expected.every(Boolean),String(set)).toBe(true)
      await expect(canvas).toHaveAttribute('data-glb-equipment',expected.flatMap(item=>item?[item.id]:[]).sort().join(','))
    }
    // Capture a real equipped set at three angles. These are visual review
    // artifacts, not a substitute for artistic or collision inspection.
    await canvas.screenshot({path:info.outputPath(style+'-conjunto-frente.png')})
    await page.getByRole('button',{name:'Girar GLB à direita'}).click()
    await page.getByRole('button',{name:'Girar GLB à direita'}).click()
    await expect(canvas).toHaveAttribute('data-glb-yaw',String(Math.PI/2))
    await canvas.screenshot({path:info.outputPath(style+'-conjunto-perfil.png')})
    await page.getByRole('button',{name:'Girar GLB à direita'}).click()
    await page.getByRole('button',{name:'Girar GLB à direita'}).click()
    await expect(canvas).toHaveAttribute('data-glb-yaw',String(Math.PI))
    await canvas.screenshot({path:info.outputPath(style+'-conjunto-costas.png')})
    await page.getByRole('button',{name:'Restaurar',exact:true}).click()
    await expect(canvas).toHaveAttribute('data-glb-yaw','0')
    await page.getByLabel('Conjunto completo').uncheck()
    await piece.selectOption('')
    await expect(canvas).toHaveAttribute('data-glb-equipment','')
    await canvas.screenshot({path:info.outputPath(style+'-vestimenta-base.png')})
    await page.getByRole('button',{name:'Rosto',exact:true}).click()
    await expect(canvas).toHaveAttribute('data-glb-zoom','true')
    await canvas.screenshot({path:info.outputPath(style+'-rosto-frente.png')})
    await page.getByRole('button',{name:'Girar GLB à direita'}).click()
    await page.getByRole('button',{name:'Girar GLB à direita'}).click()
    await canvas.screenshot({path:info.outputPath(style+'-rosto-perfil.png')})
    await page.getByRole('button',{name:'Restaurar',exact:true}).click()
    await expect(canvas).toHaveAttribute('data-glb-yaw','0')
    await expect(canvas).toHaveAttribute('data-glb-zoom','false')
    for(const hair of ['0','1','2','3']){
      await page.getByRole('combobox',{name:'Cabelo',exact:true}).selectOption(hair)
      await expect.poll(async()=>(await canvas.getAttribute('data-glb-appearance'))?.slice(0,1)).toBe(hair)
    }
    await page.getByRole('combobox',{name:'Cabelo',exact:true}).selectOption('2')
    await page.getByRole('combobox',{name:'Rosto',exact:true}).selectOption('2')
    await page.getByRole('combobox',{name:'Pele',exact:true}).selectOption('3')
    await page.getByRole('combobox',{name:'Cor do cabelo',exact:true}).selectOption('1')
    await page.getByRole('combobox',{name:'Energia',exact:true}).selectOption('4')
    await expect(canvas).toHaveAttribute('data-glb-appearance','22314')
    await canvas.screenshot({path:info.outputPath(style+'-aparencia-personalizada.png')})
    await page.getByRole('button',{name:'Girar GLB à direita'}).click()
    await page.getByRole('button',{name:'Rosto',exact:true}).click()
    await expect(canvas).toHaveAttribute('data-glb-zoom','true')
    await page.getByRole('button',{name:'Restaurar',exact:true}).click()
    await expect(canvas).toHaveAttribute('data-glb-yaw','0')
    await expect(canvas).toHaveAttribute('data-glb-zoom','false')
    const helmet=EQUIPMENT_CATALOG.find(item=>item.slot==='elmo')
    if(!helmet)throw Error('Elmo ausente')
    await piece.selectOption(helmet.id)
    await expect(canvas).toHaveAttribute('data-glb-equipment',helmet.id)
    await page.getByRole('button',{name:'Ocultar elmo'}).click()
    await expect(canvas).toHaveAttribute('data-glb-equipment','')
    await page.getByRole('button',{name:'Exibir elmo'}).click()
    await expect(canvas).toHaveAttribute('data-glb-equipment',helmet.id)
    await page.getByRole('button',{name:'Animar',exact:true}).click()
    await page.getByRole('button',{name:'Ataque',exact:true}).click()
    await expect(canvas).toHaveAttribute('data-glb-animation','attack')
    await expect.poll(async()=>Number(await canvas.getAttribute('data-glb-time'))).toBeGreaterThan(0.1)
    const first=await canvas.getAttribute('data-glb-sequence')
    await page.getByRole('button',{name:'Ataque',exact:true}).click()
    await expect(canvas).not.toHaveAttribute('data-glb-sequence',first??'')
    await page.getByRole('button',{name:'Vitória',exact:true}).click()
    await expect(canvas).toHaveAttribute('data-glb-animation','victory')
    await page.getByRole('button',{name:'Descanso',exact:true}).click()
    await expect(canvas).toHaveAttribute('data-glb-animation','rest')
    for(const [name,clip] of [['Defesa','guard'],['Esquiva','dodge'],[style==='murim'?'Canalizar Qi':'Canalizar mana','channel']]){
      await page.getByRole('button',{name,exact:true}).click()
      await expect(canvas).toHaveAttribute('data-glb-animation',clip)
      await expect.poll(async()=>Number(await canvas.getAttribute('data-glb-time'))).toBeGreaterThan(.1)
    }
    await page.getByRole('button',{name:'Repouso',exact:true}).click()
    await expect(canvas).toHaveAttribute('data-glb-animation','idle')
    await page.getByRole('button',{name:'Pausar',exact:true}).click()
    await canvas.screenshot({path:info.outputPath(style+'.png')})
  }
  expect(errors).toEqual([])
})
test('GLB: respeita movimento reduzido',async({page})=>{
  await page.emulateMedia({reducedMotion:'reduce'})
  await page.goto('/avatar-v2-lab-test')
  await expect(page.locator('canvas[data-glb-character]')).toHaveAttribute('data-glb-character','murim',{timeout:30000})
  await expect(page.getByRole('button',{name:'Ataque',exact:true})).toBeDisabled()
})
test('GLB: pausa, teclado, contraste e recuperação de contexto',async({page})=>{
  await page.goto('/avatar-v2-lab-test')
  const canvas=page.locator('canvas[data-glb-character]')
  await expect(canvas).toHaveAttribute('data-glb-character','murim',{timeout:30000})
  await page.getByRole('button',{name:'Ataque',exact:true}).click()
  await expect.poll(async()=>Number(await canvas.getAttribute('data-glb-time'))).toBeGreaterThan(.1)
  await page.getByRole('button',{name:'Pausar',exact:true}).click()
  const stopped=await canvas.getAttribute('data-glb-time')
  await page.waitForTimeout(200)
  await expect(canvas).toHaveAttribute('data-glb-time',stopped??'')
  const rotate=page.getByRole('button',{name:'Girar GLB à direita'})
  await rotate.focus()
  await expect(rotate).toBeFocused()
  await rotate.press('Enter')
  await expect(canvas).toHaveAttribute('data-glb-yaw',String(Math.PI/4))
  const result=await new AxeBuilder({page}).include('section[aria-label="Laboratório Avatar V2"]').withTags(['wcag2a','wcag2aa','wcag21a','wcag21aa']).analyze()
  expect(result.violations.map(v=>({id:v.id,nodes:v.nodes.map(n=>n.target)}))).toEqual([])
  await canvas.evaluate(el=>el.dispatchEvent(new Event('webglcontextlost',{cancelable:true})))
  await expect(page.getByText('Contexto 3D indisponível. Use o avatar original.')).toBeVisible()
  await page.getByRole('button',{name:'Tentar novamente'}).click()
  await expect(canvas).toHaveAttribute('data-glb-character','murim',{timeout:30000})
})
