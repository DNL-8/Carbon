import { expect, test } from '@playwright/test'
import { login } from './google-login'

test.use({ launchOptions: { args: ['--use-angle=swiftshader', '--enable-unsafe-swiftshader'] } })

test('Avatar V2 no Arsenal autenticado: preferências, prévia e inventário preservado', async ({ page, request }, info) => {
  test.setTimeout(120_000)
  expect((await request.post('http://127.0.0.1:38212/__fixture/reset?profiles=false')).ok()).toBeTruthy()
  await login(page, 'a')
  await page.getByRole('textbox', { name: 'Nome do herói' }).fill('Herói de homologação GLB')
  await page.getByRole('button', { name: 'Criar ficha' }).click()
  await page.getByRole('link', { name: 'Arsenal', exact: true }).filter({ visible: true }).click()
  await expect(page.getByText('104 de 104 equipamentos', { exact: true })).toBeVisible()
  const snapshot = async () => {
    const response = await page.request.get('/api/arsenal')
    expect(response.ok()).toBeTruthy()
    const data = await response.json() as {id:string;name:string;slot:string;owned:boolean;equipped:boolean}[]
    return data
  }
  const before = await snapshot()
  expect(before).toHaveLength(104)
  const original = before.filter(item => item.equipped).map(item => item.id).sort().join(',')
  const gearSettings = page.locator('.arsenal-stage').getByRole('button', { name: 'Configurações do avatar' })
  const open = page.getByRole('button', { name: 'Abrir laboratório GLB' })
  const oldAvatar = page.locator('.active-gear .warrior-avatar')
  await expect(oldAvatar).toBeVisible()
  await expect(page.locator('canvas[data-glb-character]')).toHaveCount(0)
  const settings = page.locator('.arsenal-stage').getByRole('button', { name: 'Personalizar personagem' })
  await expect(gearSettings).toHaveAttribute('aria-expanded', 'false')
  await expect(open).toHaveCount(0)
  await expect(settings).toHaveCount(0)
  await gearSettings.click()
  await expect(gearSettings).toHaveAttribute('aria-expanded', 'true')
  await expect(open).toBeVisible()
  await settings.click()
  const dialog = page.getByRole('dialog', { name: 'Personalizar personagem' })
  await dialog.getByRole('radio', { name: 'Murim · artista marcial' }).check()
  await dialog.getByRole('button', { name: 'Concluir' }).click()
  await expect(oldAvatar).toHaveAttribute('data-character','murim')
  await expect(gearSettings).toHaveAttribute('aria-expanded', 'false')
  await gearSettings.click()
  await open.click()
  await expect(gearSettings).toHaveAttribute('aria-expanded', 'false')
  const canvas = page.locator('canvas[data-glb-character]')
  await expect(canvas).toHaveAttribute('data-glb-character','murim',{timeout:30_000})
  await expect(canvas).toHaveAttribute('data-glb-skins','5')
  await expect(canvas).toHaveAttribute('data-glb-equipment',original)
  await page.getByRole('button',{name:'Pausar',exact:true}).click()
  const item = before.find(value=>!value.equipped && value.slot==='arma')
  if(!item)throw Error('Fixture sem arma de prévia')
  await page.getByRole('textbox',{name:'Buscar equipamento'}).fill(item.name)
  await page.getByRole('article',{name:item.name,exact:true}).getByRole('button',{name:'Visualizar'}).click()
  const expected = before.filter(value=>value.equipped&&value.slot!==item.slot).map(value=>value.id).concat(item.id).sort().join(',')
  await expect(canvas).toHaveAttribute('data-glb-equipment',expected)
  await canvas.screenshot({path:info.outputPath('homologacao-glb-arsenal-murim.png')})
  await page.getByRole('button',{name:'Limpar prévia'}).click()
  await expect(canvas).toHaveAttribute('data-glb-equipment',original)
  await gearSettings.click()
  await settings.click()
  await dialog.getByRole('radio',{name:'Caçador · guerreiro tático'}).check()
  await dialog.getByRole('button',{name:'Concluir'}).click()
  await expect(canvas).toHaveAttribute('data-glb-character','cacador',{timeout:30_000})
  await expect(canvas).toHaveAttribute('data-glb-equipment',original)
  await canvas.screenshot({path:info.outputPath('homologacao-glb-arsenal-cacador.png')})
  await gearSettings.click()
  await page.getByRole('button',{name:'Fechar laboratório GLB'}).click()
  await expect(gearSettings).toBeFocused()
  await expect(canvas).toHaveCount(0)
  await expect(oldAvatar).toBeVisible()
  const after = await snapshot()
  const state = (items:typeof before) => items.map(({id,owned,equipped})=>({id,owned,equipped})).sort((a,b)=>a.id.localeCompare(b.id))
  expect(state(after)).toEqual(state(before))
  await page.reload()
  await expect(oldAvatar).toHaveAttribute('data-character','cacador')
  await expect(canvas).toHaveCount(0)
  await expect(gearSettings).toHaveAttribute('aria-expanded','false')
})


test('Avatar V2 compacto no Início, Painel e sessão acompanha o combate', async ({ page, request }) => {
  test.setTimeout(120_000)
  expect((await request.post('http://127.0.0.1:38212/__fixture/reset?profiles=false')).ok()).toBeTruthy()
  await login(page,'a')
  await page.getByRole('textbox',{name:'Nome do herói'}).fill('Herói de combate GLB')
  await page.getByRole('button',{name:'Criar ficha'}).click()
  const open=page.getByRole('button',{name:'Exibir Avatar V2',exact:true})
  const canvas=page.locator('canvas[data-glb-character]')
  await expect(canvas).toHaveCount(0)
  await open.click()
  await expect(canvas).toHaveAttribute('data-glb-quality','low',{timeout:30000})
  await expect(canvas).toHaveAttribute('data-glb-skins','5')
  await page.getByRole('link',{name:'Painel',exact:true}).filter({visible:true}).click()
  await expect(page.getByRole('heading',{name:'Painel de controle'})).toBeVisible()
  await expect(canvas).toHaveAttribute('data-glb-quality','low')
  await page.getByRole('button',{name:'Ocultar Avatar V2',exact:true}).click()
  await expect(canvas).toHaveCount(0)
  await page.getByRole('link',{name:'Treinar',exact:true}).filter({visible:true}).click()
  await page.getByRole('button',{name:/^Iniciar treino:/}).first().click()
  await open.click()
  await expect(canvas).toHaveAttribute('data-glb-animation','idle',{timeout:30000})
  await page.getByRole('button',{name:'Concluir série 1',exact:true}).click()
  await expect(canvas).toHaveAttribute('data-glb-animation',/^(attack|victory)$/)
  await expect(canvas).toHaveAttribute('data-glb-sequence','1')
  await expect(page.locator('.session .warrior-avatar')).toHaveAttribute('data-attack','1')
  await page.getByRole('button',{name:'Ocultar Avatar V2',exact:true}).click()
  await expect(canvas).toHaveCount(0)
  await expect(page.locator('.session .warrior-avatar')).toBeVisible()
})
