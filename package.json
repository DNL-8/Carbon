{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.4.5",
  "scripts": {
    "db:generate": "drizzle-kit generate --config web/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config web/drizzle.config.ts",
    "dev:nuxt": "nuxt dev web",
    "build:nuxt": "nuxt build web",
    "start:nuxt": "node web/.output/server/index.mjs",
    "typecheck:nuxt": "nuxt prepare web && vue-tsc --noEmit -p web/.nuxt/tsconfig.json",
    "test:nuxt": "node --import tsx scripts/check-nuxt.mjs",
    "test:nuxt:unit": "vitest run --config web/vitest.config.ts",
    "lint:nuxt": "eslint --config web/eslint.config.mjs web --ext .ts,.vue",
    "precommit:nuxt": "bun run lint:nuxt && bun run typecheck:nuxt && bun run test:nuxt:unit",
    "dev": "next dev -p 3000 -H 0.0.0.0",
    "build": "NODE_ENV=production next build",
    "start": "next start -p 3000 -H 0.0.0.0",
    "preview": "next start",
    "clean": "rm -rf .next .next-browser",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:entry": "node --import tsx scripts/check-server-entry.mjs",
    "test:browser": "node scripts/check-app-flows.mjs"
  },
  "dependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.2.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.2.0",
    "@google/genai": "^3.3.0",
    "@neondatabase/serverless": "^1.2.1",
    "@nuxt/ui": "^4.13.1",
    "@phosphor-icons/react": "^2.1.10",
    "@pinia/nuxt": "^1.0.3",
    "@vueuse/core": "^15.1.0",
    "better-auth": "^1.7.28",
    "chart.js": "^4.6.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "drizzle-zod": "^0.8.3",
    "firebase": "^13.4.0",
    "firebase-admin": "^14.5.1",
    "hono": "^4.13.19",
    "jose": "^6.2.18",
    "motion": "^12.23.24",
    "next": "^16.4.6",
    "nuxt": "4",
    "nuxt-security": "^2.7.0",
    "pg": "^8.23.1",
    "pinia": "^4.1.0",
    "radix-ui": "^1.8.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.11.0",
    "tw-animate-css": "^1.4.0",
    "vue": "3",
    "vue-chartjs": "^5.3.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "@electric-sql/pglite-socket": "^0.3.0",
    "@hono/node-server": "^2.1.11",
    "@nuxt/eslint-config": "^1.17.0",
    "@nuxt/test-utils": "^4.4.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vue/test-utils": "^2.6.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "eslint": "^10.15.0",
    "happy-dom": "^21.0.4",
    "playwright-core": "1.62.1",
    "shadcn": "^4.23.0",
    "simple-git-hooks": "^2.14.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vitest": "^5.1.2",
    "vue-tsc": "^3.3.14"
  },
  "simple-git-hooks": {
    "pre-commit": "bun run precommit:nuxt"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.7"
  }
}
